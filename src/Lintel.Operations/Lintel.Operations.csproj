<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>In-process mediator: operations (commands/queries) with filter pipeline and notices (pub/sub).</Description>
    <PackageTags>$(PackageTags);mediator;cqrs;operations;notices;pipeline</PackageTags>
    <!-- Handler dispatch uses MakeGenericType and assembly scanning.
         Becomes AOT-compatible once registration is moved to a source generator. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
