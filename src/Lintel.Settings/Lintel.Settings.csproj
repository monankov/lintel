<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Typed settings stored in JSON or XML files, readable and writable at runtime, with hot reload and encrypted properties.</Description>
    <PackageTags>$(PackageTags);settings;configuration;json;xml</PackageTags>
    <!-- Settings are (de)serialized by reflection over user types. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
  </ItemGroup>

</Project>
